  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zupbar||Contact Us</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">

  <link rel="stylesheet" href="/css/approach.css">


<body style="margin: 0; padding: 0; background-color: whitesmoke;">

  <% if (user) { %>
  <%-include('partials/logged_navbar')%>
  <% } else { %>
  <%-include('partials/navbar')%>
  <% } %>

  <div class="cont-hedn">
    <p>Contact Us</p>

  </div>

  <div class="cont-phone">
    <p class="cont-phone-p"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Phone:</p>
  </div>

  <div class="cont-email">
    <p class="cont-email-p"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Email:</p>
  </div>

  <div class="cont-address">
    <p class="cont-address-p"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Address:</p>
  </div>

  <div class="messg-main">
    <div class="messg-submain">
      <p class="messg-submain-getintouch">Get in Touch</p>


      <div class="form-floating mb-3 messg-submain-nameDiv">
        <input type="text" class="form-control" id="name" name="name" placeholder="Like This" style="height: 5vw !important; padding:1vw 0.8vw" <% if (user) { %>
         value="<%= user.first_name %>&nbsp;<%= user.last_name %>"
        <% } %>>
        <label for="name" class="cont-formLable" style="padding: 1vw 0.8vw;">Name</label>
      </div>

      <div class="form-floating mb-3 messg-submain-emailDiv">
        <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" style="height: 5vw !important; padding:1vw 0.8vw" <% if (user) { %>
          value="<%= user.email %>"
         <% } %>>
        <label for="email" class="cont-formLable" style="padding: 1vw 0.8vw;">Email address</label>
      </div>


      <div class="input-group mb-3 messg-submain-mobileDiv">
        <span class="input-group-text messg-sunmain-mobile-countycde">+91</span>
        <div class="form-floating">
          <input type="number" class="form-control" id="mobile" name="mobile" placeholder="Username" style="height: 5vw !important; padding:1vw 0.8vw" <% if (user) { %>
            value="<%= user.phone %>"
           <% } %>>
          <label for="mobile" class="cont-formLable" style="padding: 1vw 0.8vw;">Mobile</label>
        </div>
      </div>



      <div class="form-floating messg-submain-messageDiv">
        <textarea class="form-control" placeholder="Leave a comment here" id="message"></textarea>
        <label for="message" style="font-size: 2vw;">Message</label>
      </div>

      <input class="btn btn-success messg-submain-sendbtn" type="submit" value="Send">


    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
</body>