<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zupbar || get a trip</title>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>

</head>
<link rel="stylesheet" href="/css/insidegettrip.css" />
<style data-styled="" data-styled-version="4.3.2"></style>

<body>

  <form class="bodyDiv">
    <input type="hidden" name="tour_package_rate" id="tour_package_rate" value="<%= trips.tour_package_rate %>">
    <div id="mainDiv">
      <div class="subdiv" style="overflow-y: scroll">
        <h3 class="section_heading">&rArr; Agenda</h3>
        <div class="activityCard">
          <div class="cardContainer">
            <div class="card">
              <div class="card_detail">
                <div class="card_content">
                  <div class="card_header">
                    <div class="cardLine"></div>
                    <div class="cardLine">
                      <span class="cardheading" style="font-size: 3vh"><%= trips.company_name %></span>
                    </div>
                    <div class="cardLine">
                      <span class="cardSubHeading">
                        India tours and travels
                      </span>
                    </div>
                  </div>
                  <div class="card_body">
                    <div class="card_description">
                      <div class="cardLine">Board the bus from <%= trips.tour_starting_place %></div>
                      <div class="cardLine">
                        Please ensure you reach boarding point 30 mins before
                        to avoid any rush
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <h3 class="section_heading">&rArr; Bus Details</h3>
        <div class="activityCard">
          <div class="cardContainer">
            <div class="card">
              <div class="card_detail">
                <div class="card_content">
                  <div class="card_header">
                    <div class="cardLine"></div>
                    <div class="cardLine">
                      <span class="cardheading">&#11043; Non-AC</span>
                    </div>
                    <br />
                    <div class="cardLine">
                      <span class="cardheading">&#11043; Semi-Sleeper</span>
                    </div>
                    <br />
                    <div class="cardLine">
                      <span class="cardheading">&#11043; Ultra-luxury</span>
                    </div>
                    <br />
                    <div class="cardLine">
                      <span class="cardheading">&#11043; Vlovo 9600</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="cancellationContainer ">
          <h3 class="section_heading">&rArr; Cancellation Policies</h3>
          <br />
          <table>
            <tbody>
              <tr class="header_cancellation">
                <th class="time_cancellation_text">Time of Cancellation</th>
                <th class="percentage_deduction_cancellation">
                  Deduction Percentage
                </th>
                <th class="percentage_cancellation_charges">
                  Cancellation Charges
                </th>
              </tr>
              <tr>
                <td class="durationTd">Before 25th Nov 07:30 AM</td>
                <td class="deduction_percentage">15%</td>
                <td>₹105</td>
              </tr>
              <tr>
                <td class="durationTd">
                  From 25th Nov 07:30 AM Until 26th Nov 07:30 AM
                </td>
                <td class="deduction_percentage">30%</td>
                <td>₹210</td>
              </tr>
              <tr>
                <td class="durationTd">
                  From 26th Nov 07:30 AM Until 26th Nov 09:30 PM
                </td>
                <td class="deduction_percentage">50%</td>
                <td>₹350</td>
              </tr>
              <tr>
                <td class="durationTd">
                  From 26th Nov 09:30 PM Until 27th Nov 07:30 AM
                </td>
                <td class="deduction_percentage">100%</td>
                <td>₹700</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="tncDescription ">
          <h3 class="section_heading">&rArr; Terms and Conditions</h3>
          <br>
          <br>
          <div class="termsCondition">
            1. <%= trips.tandc_1 %>
          </div>
          <div class="termsCondition">
            2. <%= trips.tandc_2 %>
          </div>
          <div class="termsCondition">
            3. <%= trips.tandc_3 %>
          </div>
          <div class="termsCondition">
            4. <%= trips.tandc_4 %>
          </div>
          <div class="termsCondition">
            5. <%= trips.tandc_5 %>
          </div>
          <div class="termsCondition">
            6. <%= trips.tandc_6 %>
          </div>
          <% if (trips.tandc_7) { %>
          <div class="termsCondition">
            7. <%= trips.tandc_7 %>
          </div>

          <% } %>

          <% if (trips.tandc_8) { %>
          <div class="termsCondition">
            8. <%= trips.tandc_8 %>
          </div>
          <% } %>

          <% if (trips.tandc_9) { %>
          <div class="termsCondition">
            9. <%= trips.tandc_9 %>
          </div>
          <% } %>

        </div>
      </div>
      <div class="subdiv">
        <div class="summary">
          <div class="summary_body fixed_summary" id="fixed_summary_cont" style="position: fixed; width: 29%">
            <div class="package_name">Kolkata to Mysore Tour</div>
            <div class="generic_section">
              <div class="journey_date">
                <span class="date_label">travel date</span>
                <span class="date">27 Nov</span>
              </div>
              <div class="includes">
                <div class="pkg_incl_label">Package Inclusions</div>
                <ul class="pkg_includes">
                  <li class="benefits">
                    <span class="text">Sightseeing</span>
                  </li>
                  <li class="benefits">
                    <span class="text">Travel</span>
                  </li>
                  <li class="benefits">
                    <span class="text">Travel</span>
                  </li>
                  <li class="benefits">
                    <span class="text">Travel</span>
                  </li>
                  <li class="benefits">
                    <span class="text">Travel</span>
                  </li>
                </ul>
              </div>
            </div>
            <div class="select_seat">
              <div class="select_seat_upcontainer">
                <div class="sela-bt-cont">
                  <div class="select_label">Book your seats</div>
                  <div class="bus_travels">
                    <span>India tours and travels</span>
                    <span>Non-AC Semi-Sleeper</span>
                  </div>
                </div>
                <div class="lnepartion"></div>
                <div class="slseno-cont">
                  <label for="number_of_seats">Select Seats :</label>
                  <input type="number" name="number_of_seats" id="number_of_seats" value="1" min="1" max="20">
                </div>

              </div>
              <button type="submit" class="book_seat_btn" id="bookSeats">Book Seats</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>


  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>

    $(document).ready( function() {

      
      var settings = {
        "url": "/goforatour/details/payments",
        "method": "POST",
        "timeout": 0,
        "headers": {
          "Content-Type": "application/json"
        },
        "data": JSON.stringify({
          "amount": "50000",

        }),
      };

      //creates new orderId everytime
      $.ajax(settings).done(function(response) {

        orderId = response.orderId;
        $("button").show();
      });
    });

    var options = {
      "key": "rzp_test_PAvdEzSBZI90ek", // Enter the Key ID generated from the Dashboard
      "amount": "50000", // Amount is in currency subunits. Default currency is INR. Hence, 50000 refers to 50000 paise
      "currency": "INR",
      "name": "Acme Corp",
      "description": "Test Transaction",
      "image": "https://example.com/your_logo",
      "order_id": ra, //This is a sample Order ID. Pass the `id` obtained in the response of Step 1
      "handler": function(response) {
        alert(response.razorpay_payment_id);
        alert(response.razorpay_order_id);
        alert(response.razorpay_signature)
      },
      "prefill": {
        "name": "Gaurav Kumar",
        "email": "gaurav.kumar@example.com",
        "contact": "9000090000"
      },
      "notes": {
        "address": "Razorpay Corporate Office"
      },
      "theme": {
        "color": "#3399cc"
      }
    };
    var rzp1 = new Razorpay(options);
    rzp1.on('payment.failed', function(response) {
      alert(response.error.code);
      alert(response.error.description);
      alert(response.error.source);
      alert(response.error.step);
      alert(response.error.reason);
      alert(response.error.metadata.order_id);
      alert(response.error.metadata.payment_id);
    });
    document.getElementById('bookSeats').onclick = function(e) {
      rzp1.open();
      e.preventDefault();
    }
  </script>


</body>

</html>