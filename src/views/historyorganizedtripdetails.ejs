<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Barbbo</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="/css/historyorganizedtripdetails.css" />

<div class="popupmain" id="popupmain">
  <form action="/triphistory/organizedtripdetails" method="post">
    <input type="hidden" name="company_name" value="<%= trips.company_name %>">
    <input type="hidden" name="company_email" value="<%= trips.company_email %>">
    <input type="hidden" name="id" value="<%= trips._id %>">
    <p>Why ?</p>
    <div class="maincontent">
      <div>
        <input type="radio" name="why_cancel_trip_option" value="seats are already filled"> seats are already filled</input>
      </div>
      <div>
        <input type="radio" name="why_cancel_trip_option" value="we are not like the service more"> we are not like the service more</input>
      </div>
      <div>
        <input type="radio" name="why_cancel_trip_option" value="we are facing some issue"> we are facing some issue</input>
      </div>
      <div>
        <input type="radio" name="why_cancel_trip_option" value="we didn't got payment in time"> we didn't got payment in time</input>
      </div>
      <div>
        <input type="radio" name="why_cancel_trip_option" value="Other"> Other</input>
      </div>
      <div>
        <input type="text" name="why_cancel_trip_thoughts" placeholder="Enter your thoughts here..."  style="width: 80%;"/>
      </div>
    </div>
    <div class="buttonDiv">
      <button type="button" onclick="hide_why()">Cancel</button>
      <button type="submit">Drop</button>
    </div>
  </form>
</div>


<div class="container light-style flex-grow-1 container-p-y" id="mainDiv">
  <h4 class="font-weight-bold py-3 mb-4">Design your trip</h4>
  <div class="card overflow-hidden">
    <div class="row no-gutters row-bordered row-border-light">
      <div class="col-md-3 pt-0">
        <div class="list-group list-group-flush account-settings-links">
          <a class="list-group-item list-group-item-action active" data-toggle="list" href="#account-general">General</a>
          <a class="list-group-item list-group-item-action" data-toggle="list" href="#tour-info">Tour
            Info</a>
          <a class="list-group-item list-group-item-action" data-toggle="list" href="#tour-vehicle-info">Vehicle Info</a>
          <a class="list-group-item list-group-item-action" data-toggle="list" href="#legal-info">Legal
            Info</a>
          <a class="list-group-item list-group-item-action" data-toggle="list" href="#account-social-links">Social links</a>
        </div>
      </div>
      <div class="col-md-9">
        <div class="tab-content">
          <div class="tab-pane fade active show" id="account-general">
            <div class="card-body">
              <div class="form-group">
                <label class="form-label" for="company_name">Company Name</label>
                <input class="form-control mb-1" value="<%= trips.company_name %>" name="company_name" id="company_name" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="company_email">Company E-mail</label>
                <input class="form-control mb-1" id="company_email" name="company_email" value="<%= trips.company_email %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="company_website">Company Website</label>
                <input class="form-control" id="company_website" name="company_website" value="<%= trips.company_website %>" readonly />
              </div>
            </div>
          </div>
          <div class="tab-pane fade" id="tour-info">
            <div class="card-body pb-2">
              <div class="form-group">
                <label class="form-label" for="tour_starting_place">Tour Starting / Ending
                  Destination</label>
                <input class="form-control" id="tour_starting_place" name="tour_starting_place" value="<%= trips.tour_starting_place %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="tour_started_date">Tour Start in</label>
                <input class="form-control" id="tour_started_date" name="tour_started_date" value="<%= trips.tour_started_date_day %> / <%= trips.tour_started_date_month %> / <%= trips.tour_started_date_year %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="tour_started_time">Boarding Time</label>
                <input class="form-control" id="tour_started_time" name="tour_started_time" value="<%= trips.tour_started_time %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="touring_destination">Touring Destination</label>
                <input class="form-control" id="touring_destination" name="touring_destination" value="<%= trips.touring_destination %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="seat_allocated">Seat Allocated</label>
                <input class="form-control" id="seat_allocated" name="seat_allocated" value="<%= trips.seat_allocated %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="tour_ended_date">Tour Ends in</label>
                <input class="form-control" id="tour_ended_date" name="tour_ended_date" value="<%= trips.tour_ended_date_day %> / <%= trips.tour_ended_date_month %> / <%= trips.tour_ended_date_year %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="tour_ended_time">Ending Time</label>
                <input class="form-control" id="tour_ended_time" name="tour_ended_time" value="<%= trips.tour_ended_time %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label">Tour Range</label>
                <span style="display: flex; font-size:large">
                  <input class="form-control" id="tourRange_day" name="tourRange_day" style="width: 5vw;" value="<%= trips.tourRange_day %>" readonly />&nbsp;&nbsp;<label for="tourRange_day">Days</label>&nbsp;&nbsp;&nbsp;
                  <input class="form-control ml-2" id="tourRange_night" name="tourRange_night" style="width: 5vw;" value="<%= trips.tourRange_night %>" readonly />&nbsp;&nbsp;<label for="tourRange_night">Nights</label>
                </span>

              </div>
              <div class="form-group">
                <label class="form-label" for="tour_package_rate">Package Rate (in INR)</label>
                <input class="form-control" id="tour_package-rate" name="tour_package_rate" value="<%= trips.tour_package_rate %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label">Package Include </label>
                <input class="form-control" value="<%= trips.tour_package_include %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="details_about_tour">Details About Tour</label>
                <textarea class="form-control" rows="5" id="details_about_tour" name="details_about_tour" aria-valuenow="<%= trips.details_about_tour %>" readonly></textarea>
              </div>
            </div>
          </div>
          <div class="tab-pane fade" id="tour-vehicle-info">
            <div class="card-body">
              <div class="form-group">
                <label class="form-label" for="vehicle_type">Vehicle Type</label>
                <input class="form-control" id="vehicle_type" name="vehicle_type" value="<%= trips.vehicle_type %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="vehicle_seat_type">Seat Type</label>
                <input class="form-control" id="vehicle_seat_type" name="vehicle_seat_type" value="<%= trips.vehicle_seat_type %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="vehicle_environment">Vehicle Environment</label>
                <input class="form-control" id="vehicle_environment" name="vehicle_environment" value="<%= trips.vehicle_environment %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label" for="vehicle_model">Vehicle Model</label>
                <input class="form-control" id="vehicle_model" name="vehicle_model" value="<%= trips.vehicle_model %>" readonly />
              </div>
            </div>
          </div>
          <div class="tab-pane fade" id="legal-info">
            <div class="card-body pb-2">
              <h6 class="mb-4"><strong>Cancellation Policies</strong></h6>
              <div class="form-group">
                <label class="form-label">Seat Cancellation</label>
                <input class="form-control" value="<%= trips.seat_cancellation %>" readonly />
                <% if (trips.seat_cancellation == "Booked seat can be cancelled") { %>
                <input class="form-control mt-3" value="<%= trips.seat_can_be_cancelled_options %>" readonly />
                <% } %>
              </div>
              <hr class="border-light m-0" />
              <h6 class="mb-4"><strong>Terms & Conditions</strong></h6>
              <p style="display: flex;">1.&nbsp;<input name="tandc_1" id="tandc_1" value="<%= trips.tandc_1 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">2.&nbsp;<input name="tandc_2" id="tandc_2" value="<%= trips.tandc_2 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">3.&nbsp;<input name="tandc_3" id="tandc_3" value="<%= trips.tandc_3 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">4.&nbsp;<input name="tandc_4" id="tandc_4" value="<%= trips.tandc_4 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">5.&nbsp;<input name="tandc_5" id="tandc_5" value="<%= trips.tandc_5 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">6.&nbsp;<input name="tandc_6" id="tandc_6" value="<%= trips.tandc_6 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">7.&nbsp;<input name="tandc_7" id="tandc_7" value="<%= trips.tandc_7 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">8.&nbsp;<input name="tandc_8" id="tandc_8" value="<%= trips.tandc_8 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p style="display: flex;">9.&nbsp;<input name="tandc_9" id="tandc_9" value="<%= trips.tandc_9 %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></p>
              <p>Other Conditions<textarea name="tandc_other" id="tandc_other" aria-valuenow="<%= trips.tandc_other %>" readonly style="width: 100%; height:fit-content; font-size: 0.7rem;"></textarea></p>
            </div>
          </div>
          <div class="tab-pane fade" id="account-social-links">
            <div class="card-body pb-2">
              <div class="form-group">
                <label class="form-label">X (Twitter)</label>
                <input class="form-control" name="social_links_twt" id="social_links_twt" value="<%= trips.social_links_twt %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label">Facebook</label>
                <input type="text" class="form-control" name="social_links_facebook" id="social_links_facebook" value="<%= trips.social_links_facebook %>" readonly />
              </div>
              <div class="form-group">
                <label class="form-label">Instagram</label>
                <input type="text" class="form-control" name="social_links_insta" id="social_links_insta" value="<%= trips.social_links_insta %>" readonly />
              </div>
            </div>
          </div>
        </div>
      </div>
      <% if (trips.isActivate == true) { %>
        <div class="text-right mb-3 ml-3">
          <button type="button" class="btn btn-danger" onclick="show_why()" style="font-weight: 600;">Stop Receiving Attendies</button>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script>
<script src="https://code.jquery.com/jquery-1.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function show_why() {
    document.getElementById('popupmain').style.display = 'block';
    document.getElementById('mainDiv').style.display = 'none';
  }

  function hide_why() {
    document.getElementById('popupmain').style.display = 'none';
    document.getElementById('mainDiv').style.display = 'block';
  }
</script>