  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Zupbar || Get a Trip</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/gettrip.css">


  <% if (user) { %>
  <%-include('partials/logged_navbar')%>
  <% } else { %>
  <%-include('partials/navbar')%>
  <% } %>


  <div id="maindiv">
    <button type="button" id="backbutton" onclick="history.back()"><strong>&#8592;
        Back</strong></button>
    <div class="all-trip">


      <% if (trips.length == 0 ) { %>
        <div class="notfoundmain">
          <div class="imgdiv">
            <img src="photos/IMG_20240205_181118.jpg" alt="">
          </div>
  
          <div class="txtdiv">
            <p><span>Sorry</span>, there are no available <span>trips</span> right now.</p>
          </div>
        </div>

        <% } else { %>
         

      <% trips.forEach(trips => { %>

      <div class="trips">

        <div class="route_details">
          <a href="/goforatour/details?id=<%= trips._id %>" class="route" title="<%= trips.tour_starting_place %> to <%= trips.touring_destination %> Package">
            <%= trips.tour_starting_place %> to <%= trips.touring_destination %>
          </a>
          <p>
            <span>Package Rate &nbsp;</span>
            <span class="fare">INR <%= trips.tour_package_rate %> /-</span>
          </p>
        </div>

        <div class="row2 D117_td" id="D117_table_column_1">
          <span class="totalRoutes">
            <%= trips.tourRange_day %> Days, <%= trips.tourRange_night %> Nights
          </span>
          <span class="totalRoutes">From :
            <strong><%= trips.tour_started_date_day %> / <%= trips.tour_started_date_month %> / <%= trips.tour_started_date_year %></strong>
          </span>
          <span class="totalRoutes">To :
            <strong><%= trips.tour_ended_date_day %> / <%= trips.tour_ended_date_month %> / <%= trips.tour_ended_date_year %></strong>
          </span>
          <span class="book_now" id="time-btn-61"><a href="/goforatour/busdetails" style="text-decoration: none; color:rgba(0, 0, 0, 0.813)">BOOK
              NOW</a>
          </span>

        </div>

      </div>
      <% }) %>

      <% } %>


      

    </div>
  </div>